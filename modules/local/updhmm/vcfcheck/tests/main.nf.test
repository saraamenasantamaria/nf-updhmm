nextflow_process {

    name "Test Process UPDHMM_VCFCHECK"
    script "../main.nf"
    process "UPDHMM_VCFCHECK"
    
    tag "modules"
    tag "modules_local"
    tag "updhmm"
    tag "updhmm/vcfcheck"

    test("trio vcf") {
    
        when {
            process {
                """
                input[0] = [
                    [ id:'test_trio',
                      proband_id: 'NA19685',
                      mother_id: 'NA19688',
                      father_id: 'NA19689' 
                    ],
                    file('${projectDir}/modules/local/updhmm/vcfcheck/tests/data/family.vcf.gz', checkIfExists: true),
                    []
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("trio vcf - stub") {

        options "-stub"
        config './vcfcheck.config'

        when {
            process {
                """
                input[0] = [
                    [ id:'test_trio',
                      proband_id: 'NA19685',
                      mother_id: 'NA19688',
                      father_id: 'NA19689' 
                    ],
                    file('${projectDir}/modules/local/updhmm/vcfcheck/tests/data/family.vcf.gz', checkIfExists: true),
                    []
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}