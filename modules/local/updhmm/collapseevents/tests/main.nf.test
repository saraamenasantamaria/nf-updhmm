nextflow_process {

    name "Test Process UPDHMM_COLLAPSEEVENTS"
    script "../main.nf"
    process "UPDHMM_COLLAPSEEVENTS"
    
    tag "modules"
    tag "modules_local"
    tag "updhmm"
    tag "updhmm/collapseevents"

    test("processed trio rds") {
    
        config './collapseevents.config'

        when {
            
            process {
                """
                input[0] = [
                    [ id:'test_trio',
                      proband_id: 'NA19685',
                      mother_id: 'NA19688',
                      father_id: 'NA19689' 
                    ],
                    file('${projectDir}/modules/local/updhmm/collapseevents/tests/data/family.rds', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
    

    test("processed trio rds - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test_trio',
                      proband_id: 'NA19685',
                      mother_id: 'NA19688',
                      father_id: 'NA19689' 
                    ],
                    file('${projectDir}/modules/local/updhmm/collapseevents/tests/data/family.rds', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}