nextflow_process {

    name "Test Process UPDHMM_CALCULATEEVENTS"
    script "../main.nf"
    process "UPDHMM_CALCULATEEVENTS"
    
    tag "modules"
    tag "modules_local"
    tag "updhmm"
    tag "updhmm/calculateevents"

    test("processed trio rds") {
    
        config './default.config'

        when {
        
            process {
                """
                input[0] = [
                    [ id:'test_trio' ],
                    file('${projectDir}/modules/local/updhmm/calculateevents/tests/data/family.processed.rds', checkIfExists: true),
                    []
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
    
    test("processed trio rds with add_ratios") {
        
        config './add_ratios.config'
        
        when {
            
            process {
                """
                input[0] = [
                    [ id:'test_trio' ],
                    file('${projectDir}/modules/local/updhmm/calculateevents/tests/data/family.processed.rds', checkIfExists: true)
                ]
                """
            }
        }
    
        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
    
    test("processed trio rds with custom HMM") {
    
        config './custom_hmm.config'

        when {
        
            process {
                """
                input[0] = [
                    [ id:'test_trio' ],
                    file('${projectDir}/modules/local/updhmm/calculateevents/tests/data/family.processed.rds', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
    
    test("processed trio rds with custom field_DP") {
    
        config './custom_field_dp.config'

        when {
            
            process {
                """
                input[0] = [
                    [ id:'test_trio' ],
                    file('${projectDir}/modules/local/updhmm/calculateevents/tests/data/family.processed.rds', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
    

    test("processed trio rds - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test_trio' ],
                    file('${projectDir}/modules/local/updhmm/calculateevents/tests/data/family.processed.rds', checkIfExists: true),
                    []
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}