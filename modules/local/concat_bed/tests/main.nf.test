nextflow_process {

    name "Test Process CONCAT_BED"
    script "../main.nf"
    process "CONCAT_BED"
    
    tag "modules"
    tag "modules_local"
    tag "concat_bed"

    test("single family - three bed files") {

        when {
            process {
                """
                input[0] = [
                    [ id:'family1', sv_p:'-', sv_m:'-', sv_f:'-' ],
                    [
                        file('${projectDir}/modules/local/concat_bed/tests/data/proband_sv.bed', checkIfExists: true),
                        file('${projectDir}/modules/local/concat_bed/tests/data/mother_sv.bed', checkIfExists: true),
                        file('${projectDir}/modules/local/concat_bed/tests/data/father_sv.bed', checkIfExists: true)
                    ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.bed.size() == 1 },
                { assert process.out.versions },
                { assert snapshot(
                    process.out.bed.collect { meta, bed ->
                        [
                            meta: [id: meta.id],
                            bed_name: file(bed).name,
                            bed_exists: file(bed).exists()
                        ]
                    },
                    process.out.versions
                ).match() }
            )
        }
    }

    test("single family - single bed file") {

        when {
            process {
                """
                input[0] = [
                    [ id:'family2', sv_p:'-', sv_m:'-', sv_f:'-' ],
                    file('${projectDir}/modules/local/concat_bed/tests/data/proband_sv.bed', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.bed.size() == 1 },
                { assert process.out.versions },
                { assert snapshot(
                    process.out.bed.collect { meta, bed ->
                        [
                            meta: [id: meta.id],
                            bed_name: file(bed).name,
                            bed_exists: file(bed).exists()
                        ]
                    },
                    process.out.versions
                ).match() }
            )
        }
    }

    test("multiple families - batch processing") {

        when {
            process {
                """
                input[0] = Channel.of(
                    [
                        [ id:'family1', sv_p:'-', sv_m:'-', sv_f:'-' ],
                        [
                            file('${projectDir}/modules/local/concat_bed/tests/data/proband_sv.bed', checkIfExists: true),
                            file('${projectDir}/modules/local/concat_bed/tests/data/mother_sv.bed', checkIfExists: true)
                        ]
                    ],
                    [
                        [ id:'family2', sv_p:'-', sv_m:'-', sv_f:'-' ],
                        file('${projectDir}/modules/local/concat_bed/tests/data/father_sv.bed', checkIfExists: true)
                    ]
                )
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.bed.size() == 2 },
                { assert process.out.versions },
                { assert snapshot(
                    process.out.bed.collect { meta, bed ->
                        [
                            meta: [id: meta.id],
                            bed_name: file(bed).name,
                            bed_exists: file(bed).exists()
                        ]
                    }.sort { it.meta.id },
                    process.out.versions
                ).match() }
            )
        }
    }

    test("single family - three bed files - stub") {
        
        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'family1', sv_p:'-', sv_m:'-', sv_f:'-' ],
                    [
                        file('${projectDir}/modules/local/concat_bed/tests/data/proband_sv.bed', checkIfExists: true),
                        file('${projectDir}/modules/local/concat_bed/tests/data/mother_sv.bed', checkIfExists: true),
                        file('${projectDir}/modules/local/concat_bed/tests/data/father_sv.bed', checkIfExists: true)
                    ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

}