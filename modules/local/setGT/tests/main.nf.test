nextflow_process {

    name "Test Process SETGT"
    script "../main.nf"
    process "SETGT"
    tag "modules"
    tag "modules_local"
    tag "setgt"

    test("single family") {

        when {
            process {
                """
                input[0] = [
                    [ id:'family1' ],
                    file('${projectDir}/modules/local/setGT/tests/data/family.vcf.gz', checkIfExists: true),
                    []
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.vcf,
                    process.out.tbi,
                    process.out.versions
                ).match() }
            )
        }
    }

    test("single family - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'family1' ],
                    file('${projectDir}/modules/local/setGT/tests/data/family.vcf.gz', checkIfExists: true),
                    []
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}