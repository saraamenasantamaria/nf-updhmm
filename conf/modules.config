/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    withName: 'TABIX_TABIX' {
        // Index VCF files for efficient random access
        ext.prefix = { "${meta.id}" }
        ext.args = '-p vcf'
        //publishDir = [ path: "${params.outdir}/PREPROCESS/INDICES", mode: 'copy' ]
    }

    withName: 'BCFTOOLS_VIEW_AUTOSOMES' {
        // Filter VCF files to keep only autosomal chromosomes (chr1-chr22)
        ext.prefix = { "${meta.id}_autosomes" }
        ext.args = '-r chr1,chr2,chr3,chr4,chr5,chr6,chr7,chr8,chr9,chr10,chr11,chr12,chr13,chr14,chr15,chr16,chr17,chr18,chr19,chr20,chr21,chr22 -Oz -W=tbi --no-version'
        //publishDir = [ path: "${params.outdir}/PREPROCESS/REMOVE_ANNOTATIONS", mode: 'copy' ]
    }
    
    withName: 'BCFTOOLS_DELETE_ANNOTATIONS' {
        ext.prefix = { "${meta.id}_filtered" }
        ext.args = '-x INFO,^FORMAT/GT,FORMAT/AD,FORMAT/DP,FORMAT/GQ -Oz -W=tbi --no-version'
        //publishDir = [ path: "${params.outdir}/PREPROCESS/REMOVE_ANNOTATIONS", mode: 'copy' ]
    }
    
    withName: 'BCFTOOLS_DELETE_ANNOTATIONS_GVCF' {
        // Remove unused annotations to speed up processing and reduce memory usage
        ext.prefix = { "${meta.id}_filtered" }
        ext.args = '-x ^INFO/END,^FORMAT/GT,FORMAT/AD,FORMAT/DP,FORMAT/GQ,FORMAT/PL, -Oz -W=tbi --no-version'
        //publishDir = [ path: "${params.outdir}/PREPROCESS/REMOVE_ANNOTATIONS", mode: 'copy' ]
    }
    
    
    // REVISAR ESTO BIEN
    
    //
    // Extract ambiguous variants per individual based on VAF
    //
    withName: 'BCFTOOLS_EXTRACT_AMBIGUOUS_VAF' {
        ext.prefix = { "${meta.id}_ambiguous_vaf" }
        ext.args = { 
            """
            -i '(FMT/AD[0:0]+FMT/AD[0:1])>0 && \
                ((FMT/AD[0:1]/(FMT/AD[0:0]+FMT/AD[0:1])>=0.15 && \
                  FMT/AD[0:1]/(FMT/AD[0:0]+FMT/AD[0:1])<=0.30) || \
                 (FMT/AD[0:1]/(FMT/AD[0:0]+FMT/AD[0:1])>=0.70 && \
                  FMT/AD[0:1]/(FMT/AD[0:0]+FMT/AD[0:1])<=0.85))' \
            -Oz -W=tbi --no-version
            """.stripIndent().trim()
        }
    }
    
    //
    // Convert ambiguous VAF variants to BED format
    //
    withName: 'BCFTOOLS_QUERY_VAF_TO_BED' {
        ext.prefix = { "${meta.id}_vaf_ambiguous" }
        ext.args = { "-f '%CHROM\\t%POS0\\t%END\\n'" }
    }
    
    //
    // Genotype correction based on clear VAF
    //
    withName: 'BCFTOOLS_SETGT_VAF' {
        ext.prefix = { "${meta.id}_gt_corrected" }
    }

    //
    
    withName: GATK4_COMBINEGVCFS {
      ext.args = '--create-output-variant-index true --add-output-vcf-command-line false'
      //publishDir = [ path: "${params.outdir}/PREPROCESS/COMBINE_GVCF", mode: 'copy' ]
    }
    
    withName: GATK4_GENOTYPEGVCFS {
      ext.args = '--add-output-vcf-command-line false'
      //publishDir = [ path: "${params.outdir}/PREPROCESS/COMBINE_GVCF", mode: 'copy' ]
    }

    withName: BCFTOOLS_ISEC {
        // Intersect trio VCFs to retain only common variants across all three samples
        ext.args = '-n=3 -c all -Oz --no-version'
        //publishDir = [ path: "${params.outdir}/PREPROCESS/COMBINE_VCF", mode: 'copy' ]
    }

    withName: BCFTOOLS_MERGE {
        // Merge common variants across trio into a single VCF file
        ext.args = '-Oz -W=tbi --no-version'
        //publishDir = [ path: "${params.outdir}/PREPROCESS/COMBINE_VCF", mode: 'copy' ]
    }

    withName: 'BCFTOOLS_QUERY' {
        // Convert VCF structural variants to BED format
        ext.prefix = { meta.temp_id }
        ext.suffix = 'bed'
        ext.args = '-i "FILTER=\\"PASS\\" && (INFO/SVTYPE==\\"DEL\\" || INFO/SVTYPE==\\"DUP\\")" -f "%CHROM\t%POS0\t%END\n"'
        //publishDir = [path: "${params.outdir}/PREPROCESS/SV_MASK_BED", mode: 'copy']
    }
    
    withName: 'CUSTOM_BEDCONCAT' {
        // Concatenate multiple BED files into a single unified file
        ext.prefix = { "${meta.id}_svs_concatenated" }
        //publishDir = [ path: "${params.outdir}/PREPROCESS/SV_MASK_BED", mode: 'copy' ]
    }
   
    withName: 'BEDTOOLS_MERGE' {
        // Merge overlapping BED regions into a unified mask for SV filtering
        ext.prefix = { "${meta.id}_merged" }
        //publishDir = [ path: "${params.outdir}/PREPROCESS/SV_MASK_BED", mode: 'copy' ]
    }
    
    withName: 'VIEW_MASK' {
        // Remove variants overlapping structural variants (SVs) using BED mask
        ext.prefix = { "${meta.id}_preprocessed" }
        ext.args = '-Oz -W=tbi --no-version'  
        //publishDir = [ path: "${params.outdir}/PREPROCESS/SV_MASK_BED", mode: 'copy' ]
    }    
        
    ///////////////////////////////////////////////////////////////////////////////////////////
    withName: BCFTOOLS_SETGT {
        // Fill missing genotypes by setting them to homozygous reference (0/0 or 0)
        ext.prefix = { "${meta.id}_fixed_gt" }
        //publishDir = [ path: "${params.outdir}/PREPROCESS/FILTER_LOWCONF", mode: 'copy' ]
    }
   
     withName: 'BCFTOOLS_VIEW_BIALLELIC' {
         // Keep only biallelic SNPs and exclude variants with missing genotypes
         ext.prefix = { "${meta.id}_snps_biallelic" }
         ext.args = "-m2 -M2 -v snps -Oz -W=tbi -e \"GT~'\\\\.'\" --no-version"
         //publishDir = [ path: "${params.outdir}/PREPROCESS/FILTER_LOWCONF", mode: 'copy' ]
     }  

    withName: 'BCFTOOLS_VIEW_QUAL_MIN' {
        // Apply minimum quality/depth thresholds (default: GQ=0, DP=0)
        ext.prefix = { "${meta.id}_snps_biallelic_qualMin" }
        ext.args = { "-i 'FILTER=\"PASS\" && MIN(FMT/GQ)>=${params.GQ_min} && MIN(FMT/DP)>=${params.DP_min}' -Oz -W=tbi --no-version" }
        //publishDir = [ path: "${params.outdir}/PREPROCESS/FILTER_LOWCONF", mode: 'copy' ]
    }

    withName: 'BCFTOOLS_VIEW_REFHOMO_EXCLUDE' {
        // Exclude variants homozygous for the reference allele in all trio members
        ext.prefix = { "${meta.id}_snps_biallelic_qualMin_noRefHom" }
        ext.args = "-e 'COUNT(GT=\"0/0\")+COUNT(GT=\"0|0\")==3' -Oz -W=tbi --no-version"
        //publishDir = [ path: "${params.outdir}/PREPROCESS/FILTER_LOWCONF", mode: 'copy' ]
    }


    withName: BCFTOOLS_VIEW_EXCL_ALL {
        // Exclude all problematic regions (centromeres, segmental duplications, HLA/KIR)
        ext.prefix = { "${meta.id}_filtered_final" }
        ext.args = { 
            def excluded_regions_file = params.excluded_regions_bed ?: "https://zenodo.org/records/17193905/files/${params.genome_build}_excluded_regions.bed"
            return "-T ^${excluded_regions_file} -Oz -W=tbi --no-version"
        }
        publishDir = [
            path: { "${params.outdir}/PREPROCESS/RESULTS" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }  
    
//    withName: 'BCFTOOLS_VIEW_FILTER_ALL' {
//        ext.prefix = { "${meta.id}_filtered_final" }
//        ext.args = { 
//            def regions = params.excluded_regions_bed ?: "${projectDir}/assets/${params.genome_build}_excluded_regions.bed"
//            def qual_filter = "FILTER='PASS' && MIN(FMT/GQ)>=${params.GQ_min} && MIN(FMT/DP)>=${params.DP_min}"
//            def excl_filter = "GT~'\\\\.' || (COUNT(GT='0/0')+COUNT(GT='0|0')==3)"
//            
//            "-m2 -M2 -v snps -i '${qual_filter}' -e '${excl_filter}' -T ^${regions} -Oz -W=tbi --no-version"
//        }
//        publishDir = [
//            path: { "${params.outdir}/PREPROCESS/RESULTS" },
//            mode: params.publish_dir_mode,
//            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
//        ]
//    }
        
    ///////////////////////////////////////////////////////////////////////////////////////////

    withName: UPDHMM_VCFCHECK {
        // Validate and format the combined VCF as a largeCollapsedVcf object for UPD analysis
        ext.prefix = { "${meta.id}" }
        //publishDir = [ path: "${params.outdir}/UPD_ANALYSIS", mode: 'copy' ]
    }
    
    withName: UPDHMM_CALCULATEEVENTS {
        // Run UPDhmm core functions to detect genomic blocks consistent with UPD                        
        ext.prefix = { "${meta.id}" }
        publishDir = [ path: "${params.outdir}/UPD_ANALYSIS", mode: 'copy' ]
    }
    
    withName: UPDHMM_COLLAPSEEVENTS {   
        // Merge overlapping blocks of the same UPD type within chromosomes    
        ext.prefix = { "${meta.id}" }
        publishDir = [ path: "${params.outdir}/UPD_ANALYSIS", mode: 'copy' ]
    }
}