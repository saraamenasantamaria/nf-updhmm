nextflow_workflow {

    name "Test Subworkflow COMBINE_VCF"
    script "../main.nf"
    workflow "COMBINE_VCF"

    test("combine_vcf - with intersection") {
        when {
            params {
                perform_intersection = true
            }
            workflow {
                """
                input[0] = Channel.of([
                    [
                        id: 'family1',
                        sv_p: '-',
                        sv_m: '-', 
                        sv_f: '-'
                    ],
                    [
                        file('${projectDir}/subworkflows/local/combine_vcf/tests/data/proband.vcf.gz', checkIfExists: true),
                        file('${projectDir}/subworkflows/local/combine_vcf/tests/data/mother.vcf.gz', checkIfExists: true),
                        file('${projectDir}/subworkflows/local/combine_vcf/tests/data/father.vcf.gz', checkIfExists: true)
                    ],
                    [
                        file('${projectDir}/subworkflows/local/combine_vcf/tests/data/proband.vcf.gz.tbi', checkIfExists: true),
                        file('${projectDir}/subworkflows/local/combine_vcf/tests/data/mother.vcf.gz.tbi', checkIfExists: true),
                        file('${projectDir}/subworkflows/local/combine_vcf/tests/data/father.vcf.gz.tbi', checkIfExists: true)
                    ]
                ])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    workflow.out.vcfs.collect { meta, vcf, tbi -> 
                        [
                            meta: meta,
                            vcf_exists: file(vcf).exists(),
                            tbi_exists: file(tbi).exists()
                        ]
                    },
                    workflow.out.versions
                ).match("with_intersection") }
            )
        }
    }

    test("combine_vcf - without intersection") {
        when {
            params {
                perform_intersection = false
            }
            workflow {
                """
                input[0] = Channel.of([
                    [
                        id: 'family1',
                        sv_p: '-',
                        sv_m: '-', 
                        sv_f: '-'
                    ],
                    [
                        file('${projectDir}/subworkflows/local/combine_vcf/tests/data/proband.vcf.gz', checkIfExists: true),
                        file('${projectDir}/subworkflows/local/combine_vcf/tests/data/mother.vcf.gz', checkIfExists: true),
                        file('${projectDir}/subworkflows/local/combine_vcf/tests/data/father.vcf.gz', checkIfExists: true)
                    ],
                    [
                        file('${projectDir}/subworkflows/local/combine_vcf/tests/data/proband.vcf.gz.tbi', checkIfExists: true),
                        file('${projectDir}/subworkflows/local/combine_vcf/tests/data/mother.vcf.gz.tbi', checkIfExists: true),
                        file('${projectDir}/subworkflows/local/combine_vcf/tests/data/father.vcf.gz.tbi', checkIfExists: true)
                    ]
                ])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    workflow.out.vcfs.collect { meta, vcf, tbi -> 
                        [
                            meta: meta,
                            vcf_exists: file(vcf).exists(),
                            tbi_exists: file(tbi).exists()
                        ]
                    },
                    workflow.out.versions
                ).match("without_intersection") }
            )
        }
    }

