    test("single sample - no sv files") {

        when {
            workflow {
                """
                input[0] = Channel.of([
                    [
                        id: 'family4',
                        sv_p: '-',
                        sv_m: '-',
                        sv_f: '-'
                    ],
                    file('${projectDir}/subworkflows/local/sv_mask_bed/tests/data/family.vcf.gz', checkIfExists: true),
                    file('${projectDir}/subworkflows/local/sv_mask_bed/tests/data/family.vcf.gz.tbi', checkIfExists: true)
                ])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().size() == 0 }, // No tasks should run for pass-through
                { assert workflow.out.vcf.size() == 1 },
                { assert snapshot(
                    workflow.out.vcf.collect { meta, vcf, tbi -> 
                        [
                            meta: [
                                id: meta.id,
                                sv_p: meta.sv_p,
                                sv_m: meta.sv_m,
                                sv_f: meta.sv_f
