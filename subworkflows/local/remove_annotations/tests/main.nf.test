nextflow_workflow {

    name "Test Subworkflow REMOVE_ANNOTATIONS"
    script "../main.nf"
    workflow "REMOVE_ANNOTATIONS"
    
    tag "subworkflows"
    tag "subworkflows_local"
    tag "remove_annotations"
    tag "tabix"
    tag "tabix/tabix"
    tag "bcftools"
    tag "bcftools/view"
    tag "bcftools/annotate"

    test("single family") {

        when {
            workflow {
                """
                input[0] = Channel.of([
                    [
                        id: 'family1',
                        sv_p: '-',
                        sv_m: '-', 
                        sv_f: '-'
                    ],
                    [
                        file('${projectDir}/subworkflows/local/remove_annotations/tests/data/proband.vcf.gz', checkIfExists: true),
                        file('${projectDir}/subworkflows/local/remove_annotations/tests/data/mother.vcf.gz', checkIfExists: true),
                        file('${projectDir}/subworkflows/local/remove_annotations/tests/data/father.vcf.gz', checkIfExists: true)
                    ]
                ])
                input[1] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().size() == 9 },
                { assert workflow.out.vcf.get(0).get(1).size() == 3 }, // 3 VCF files
                { assert workflow.out.vcf.get(0).get(2).size() == 3 }, // 3 TBI files
                { assert snapshot(
                    workflow.out.vcf.collect { meta, vcf, tbis -> 
                        [
                            meta: meta,
                            vcf_count: vcf.size(),
                            tbi_count: tbis.size(),
                            vcf_names: vcf.collect { it instanceof java.nio.file.Path ? it.name : it.toString() },
                            tbi_names: tbis.collect { it instanceof java.nio.file.Path ? it.name : it.toString() }
                        ]
                    },
                    workflow.out.versions
                ).match() }
            )
        }
    }
    
    test("multiple families") {

        when {
            workflow {
                """
                input[0] = Channel.of([
                        [
                            id: 'family1',
                            sv_p: '-',
                            sv_m: '-', 
                            sv_f: '-'
                        ],
                        [
                            file('${projectDir}/subworkflows/local/remove_annotations/tests/data/proband.vcf.gz', checkIfExists: true),
                            file('${projectDir}/subworkflows/local/remove_annotations/tests/data/mother.vcf.gz', checkIfExists: true),
                            file('${projectDir}/subworkflows/local/remove_annotations/tests/data/father.vcf.gz', checkIfExists: true)
                        ]
                    ],
                    [
                        [
                            id: 'family2',
                            sv_p: '-',
                            sv_m: '-', 
                            sv_f: '-'
                        ],
                        [
                            file('${projectDir}/subworkflows/local/remove_annotations/tests/data/proband.vcf.gz', checkIfExists: true),
                            file('${projectDir}/subworkflows/local/remove_annotations/tests/data/mother.vcf.gz', checkIfExists: true),
                            file('${projectDir}/subworkflows/local/remove_annotations/tests/data/father.vcf.gz', checkIfExists: true)
                        ]
                    ])
                input[1] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().size() == 18 },
                { assert snapshot(
                    workflow.out.vcf.collect { meta, vcf, tbis -> 
                        [
                            meta: [
                                id: meta.id,
                                sv_p: meta.sv_p,
                                sv_m: meta.sv_m,
                                sv_f: meta.sv_f
                            ],
                            vcf_count: vcf.size(),
                            tbi_count: tbis.size(),
                            vcf_names: vcf.collect { it instanceof java.nio.file.Path ? it.name : it.toString() },
                            tbi_names: tbis.collect { it instanceof java.nio.file.Path ? it.name : it.toString() }
                        ]
                    }.sort { it.meta.id },
                    workflow.out.versions
                ).match() }
            )
        }
    }

    test("single family - stub") {
    
        options "-stub"

        when {
            workflow {
                """
                input[0] = Channel.of([
                    [
                        id: 'family1',
                        sv_p: '-',
                        sv_m: '-', 
                        sv_f: '-'
                    ],
                    [
                        file('${projectDir}/subworkflows/local/remove_annotations/tests/data/proband.vcf.gz', checkIfExists: true),
                        file('${projectDir}/subworkflows/local/remove_annotations/tests/data/mother.vcf.gz', checkIfExists: true),
                        file('${projectDir}/subworkflows/local/remove_annotations/tests/data/father.vcf.gz', checkIfExists: true)
                    ]
                ])
                input[1] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }
    }

    test("single family - gvcf mode") {

        when {
            workflow {
                """
                input[0] = Channel.of([
                    [
                        id: 'family1',
                        sv_p: '-',
                        sv_m: '-', 
                        sv_f: '-'
                    ],
                    [
                        file('${projectDir}/subworkflows/local/remove_annotations/tests/data/proband.vcf.gz', checkIfExists: true),
                        file('${projectDir}/subworkflows/local/remove_annotations/tests/data/mother.vcf.gz', checkIfExists: true),
                        file('${projectDir}/subworkflows/local/remove_annotations/tests/data/father.vcf.gz', checkIfExists: true)
                    ]
                ])
                input[1] = true 
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().size() == 9 },
                { assert workflow.out.vcf.get(0).get(1).size() == 3 }, // 3 VCF files
                { assert workflow.out.vcf.get(0).get(2).size() == 3 }, // 3 TBI files
                { assert snapshot(
                    workflow.out.vcf.collect { meta, vcf, tbis -> 
                        [
                            meta: meta,
                            vcf_count: vcf.size(),
                            tbi_count: tbis.size(),
                            vcf_names: vcf.collect { it instanceof java.nio.file.Path ? it.name : it.toString() },
                            tbi_names: tbis.collect { it instanceof java.nio.file.Path ? it.name : it.toString() }
                        ]
                    },
                    workflow.out.versions
                ).match() }
            )
        }
    }

    test("single family - gvcf mode - stub") {
        
        options "-stub"

        when {
            workflow {
                """
                input[0] = Channel.of([
                    [
                        id: 'family1',
                        sv_p: '-',
                        sv_m: '-', 
                        sv_f: '-'
                    ],
                    [
                        file('${projectDir}/subworkflows/local/remove_annotations/tests/data/proband.vcf.gz', checkIfExists: true),
                        file('${projectDir}/subworkflows/local/remove_annotations/tests/data/mother.vcf.gz', checkIfExists: true),
                        file('${projectDir}/subworkflows/local/remove_annotations/tests/data/father.vcf.gz', checkIfExists: true)
                    ]
                ])
                input[1] = true
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }
    }
}