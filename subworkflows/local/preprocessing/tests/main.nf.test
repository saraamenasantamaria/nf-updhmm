    test("preprocessing - error handling - invalid samplesheet") {
        when {
            workflow {
                """
                input[0] = file('${projectDir}/subworkflows/local/preprocessing/tests/data/invalid_samplesheet.csv', checkIfExists: true)
                input[1] = false
                input[2] = true
                input[3] = []
                input[4] = []
                input[5] = []
                """
            }
        }

        then {
            assert workflow.failed
        }
    }
