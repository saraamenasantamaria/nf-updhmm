nextflow_workflow {

    name "Test Subworkflow PREPROCESSING"
    script "../main.nf"
    workflow "PREPROCESSING"
    
    
    tag "subworkflows"
    tag "subworkflows_local"
    tag "preprocessing"
    
    tag "remove_annotations"
    tag "vcf_combine"
    tag "gvcf_combine"
    tag "sv_mask_bed"
    tag "filter_lowconf"
    
    tag "tabix"
    tag "bcftools"
    tag "gatk4"
    tag "bedtools"
    
    
    tag "tabix/tabix"
    tag "bcftools/view"
    tag "bcftools/annotate"
    tag "bcftools/isec"
    tag "bcftools/merge"
    tag "bcftools/query"
    tag "gatk4/combinegvcfs"
    tag "gatk4/genotypegvcfs"
    tag "bedtools/merge"
    tag "concat_bed"
    tag "setgt"
    


    test("preprocessing - with intersection and no SVs") {
        when {
            workflow {
                """
                input[0] = file('${projectDir}/subworkflows/local/preprocessing/tests/data/samplesheet.csv', checkIfExists: true)
                input[1] = false
                input[2] = true
                input[3] = []
                input[4] = []
                input[5] = []
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    workflow.out.vcf.collect { meta, vcf, tbi -> 
                        [
                            meta: meta,
                            vcf_exists: file(vcf).exists(),
                            tbi_exists: file(tbi).exists()
                        ]
                    },
                    workflow.out.versions
                ).match("with_intersection_no_svs") }
            )
        }
    }

