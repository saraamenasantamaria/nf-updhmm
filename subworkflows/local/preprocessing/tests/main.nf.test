    test("preprocessing - multiple families") {
        when {
            workflow {
                """
                input[0] = file('${projectDir}/subworkflows/local/preprocessing/tests/data/samplesheet_multiple_families.csv', checkIfExists: true)
                input[1] = false
                input[2] = true
                input[3] = []
                input[4] = []
                input[5] = []
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.vcf.size() == 2 },
                { assert snapshot(
                    workflow.out.vcf.collect { meta, vcf, tbi -> 
                        [
                            meta: meta,
                            vcf_exists: file(vcf).exists(),
                            tbi_exists: file(tbi).exists()
                        ]
                    },
                    workflow.out.versions
                ).match("multiple_families") }
            )
        }
    }

