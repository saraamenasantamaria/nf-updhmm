    test("preprocess_vcf - multiple families") {
        when {
            params {
                perform_intersection = true
            }
            workflow {
                """
                input[0] = file('${projectDir}/subworkflows/local/preprocess_vcf/tests/data/samplesheet_multiple_families.csv', checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.vcfs.size() == 2 },
                { assert snapshot(
                    workflow.out.vcfs.collect { meta, vcf, tbi -> 
                        [
                            meta: meta,
                            vcf_exists: file(vcf).exists(),
                            tbi_exists: file(tbi).exists()
