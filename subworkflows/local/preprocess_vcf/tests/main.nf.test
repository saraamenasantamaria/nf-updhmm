    test("preprocess_vcf - error handling - invalid samplesheet") {
        when {
            workflow {
                """
                input[0] = file('${projectDir}/subworkflows/local/preprocess_vcf/tests/data/invalid_samplesheet.csv', checkIfExists: true)
                """
