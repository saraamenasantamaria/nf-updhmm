nextflow_workflow {

    name "Test Subworkflow PREPROCESS_VCF"
    script "../main.nf"
    workflow "PREPROCESS_VCF"

    test("preprocess_vcf - with intersection and no SVs") {
        when {
            params {
                perform_intersection = true
            }
            workflow {
                """
                input[0] = file('${projectDir}/subworkflows/local/preprocess_vcf/tests/data/samplesheet.csv', checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    workflow.out.vcfs.collect { meta, vcf, tbi -> 
                        [
                            meta: meta,
                            vcf_exists: file(vcf).exists(),
                            tbi_exists: file(tbi).exists()
                        ]
                    },
                    workflow.out.versions
                ).match("with_intersection_no_svs") }
            )
        }
    }

    test("preprocess_vcf - without intersection and no SVs") {
        when {
            params {
                perform_intersection = false
            }
            workflow {
                """
                input[0] = file('${projectDir}/subworkflows/local/preprocess_vcf/tests/data/samplesheet.csv', checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    workflow.out.vcfs.collect { meta, vcf, tbi -> 
                        [
                            meta: meta,
                            vcf_exists: file(vcf).exists(),
                            tbi_exists: file(tbi).exists()
                        ]
                    },
                    workflow.out.versions
                ).match("without_intersection_no_svs") }
            )
        }
    }

