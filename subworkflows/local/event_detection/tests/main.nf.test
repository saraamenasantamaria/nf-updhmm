nextflow_workflow {

    name "Test Subworkflow EVENT_DETECTION"
    script "../main.nf"
    workflow "EVENT_DETECTION"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "subworkflows/event_detection"
    tag "updhmm"
    tag "updhmm/vcfcheck"
    tag "updhmm/calculateevents"
    tag "updhmm/collapseevents"
    
    setup {
        run("BCFTOOLS_VIEW") {
            script "../../../../modules/nf-core/bcftools/view/main.nf"
            process {
                """
                input[0] = Channel.of([
                    [ id:'test_trio' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/vcf/ped/justhusky_minimal.vcf.gz', checkIfExists: true),
                    []
                ])
                input[1] = []  // regions
                input[2] = []  // targets
                input[3] = []  // samples
                """
            }
        }
    }
    

    test("trio vcf") {

        config './nextflow.config'
        
        when {
            workflow {
                """
                input[0] = BCFTOOLS_VIEW.out.vcf.map { meta, vcf ->
                    [
                        [ id:'test_trio',
                          proband_id: 'hugelymodelbat',
                          mother_id: 'slowlycivilbuck',
                          father_id: 'earlycasualcaiman' 
                        ],
                        vcf,
                        []
                    ]
                }
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }
    }

    test("trio vcf - stub") {

        options "-stub"
        config './nextflow.config'

        when {
            workflow {
                """
                input[0] = BCFTOOLS_VIEW.out.vcf.map { meta, vcf ->
                    [
                        [ id:'test_trio',
                          proband_id: 'hugelymodelbat',
                          mother_id: 'slowlycivilbuck',
                          father_id: 'earlycasualcaiman' 
                        ],
                        vcf,
                        []
                    ]
                }
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }
    }
}