    test("trio vcf - stub") {
        
        options "-stub"
        config "./nextflow.config"
        
        when {
            workflow {
                """
                input[0] = Channel.of([
                    [
                        id: 'trio_test',
                        sv_p: '-',
                        sv_m: '-', 
                        sv_f: '-'
                    ],
                    file('${projectDir}/subworkflows/local/filter_lowconf/tests/data/trio_test.vcf.gz', checkIfExists: true),
                    file('${projectDir}/subworkflows/local/filter_lowconf/tests/data/trio_test.vcf.gz.tbi', checkIfExists: true)
                ])
                input[1] = false
                input[2] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }
    }
