    test("trio vcf without intersection and with vaf correction") {
        
        config "./nextflow.config"
        
        when {
            workflow {
                """
                input[0] = Channel.of([
                    [
                        id: 'trio_test',
                        sv_p: '-',
                        sv_m: '-', 
