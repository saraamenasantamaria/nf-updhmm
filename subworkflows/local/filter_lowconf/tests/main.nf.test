nextflow_workflow {

    name "Test Subworkflow FILTER_LOWCONF"
    script "../main.nf"
    workflow "FILTER_LOWCONF"
    
    tag "subworkflows"
    tag "subworkflows_local"
    tag "filter_lowconf"
    tag "bcftools"
    tag "bcftools/view"
    tag "setgt"

    test("single sample - without intersection") {

        when {
            workflow {
                """
                input[0] = Channel.of([
                    [
                        id: 'family1',
                        sv_p: '-',
                        sv_m: '-', 
                        sv_f: '-'
                    ],
                    file('${projectDir}/subworkflows/local/filter_lowconf/tests/data/family1.vcf.gz', checkIfExists: true),
                    file('${projectDir}/subworkflows/local/filter_lowconf/tests/data/family1.vcf.gz.tbi', checkIfExists: true)
                ])
                input[1] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().size() > 0 },
                { assert workflow.out.vcf.size() == 1 },
                { assert snapshot(
                    workflow.out.vcf.collect { meta, vcf, tbi -> 
                        [
                            meta: [
                                id: meta.id,
                                sv_p: meta.sv_p,
                                sv_m: meta.sv_m,
                                sv_f: meta.sv_f
                            ],
                            vcf_name: file(vcf).name,
                            tbi_name: file(tbi).name
                        ]
                    },
                    workflow.out.versions
                ).match() }
            )
        }
    }

    test("single sample - with intersection") {

        when {
            workflow {
                """
                input[0] = Channel.of([
                    [
                        id: 'family2',
                        sv_p: '-',
                        sv_m: '-', 
                        sv_f: '-'
                    ],
                    file('${projectDir}/subworkflows/local/filter_lowconf/tests/data/family2.vcf.gz', checkIfExists: true),
                    file('${projectDir}/subworkflows/local/filter_lowconf/tests/data/family2.vcf.gz.tbi', checkIfExists: true)
                ])
                input[1] = true
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().size() > 0 },
                { assert workflow.out.vcf.size() == 1 },
                { assert snapshot(
                    workflow.out.vcf.collect { meta, vcf, tbi -> 
                        [
                            meta: [
                                id: meta.id,
                                sv_p: meta.sv_p,
                                sv_m: meta.sv_m,
                                sv_f: meta.sv_f
                            ],
                            vcf_name: file(vcf).name,
                            tbi_name: file(tbi).name
                        ]
                    },
                    workflow.out.versions
                ).match() }
            )
        }
    }

    test("multiple samples - mixed intersection modes") {

        when {
            workflow {
                """
                input[0] = Channel.of(
                    [
                        [
                            id: 'family1',
                            sv_p: '-',
                            sv_m: '-',
                            sv_f: '-'
                        ],
                        file('${projectDir}/subworkflows/local/filter_lowconf/tests/data/family1.vcf.gz', checkIfExists: true),
                        file('${projectDir}/subworkflows/local/filter_lowconf/tests/data/family1.vcf.gz.tbi', checkIfExists: true)
                    ],
                    [
                        [
                            id: 'family2',
                            sv_p: '-',
                            sv_m: '-',
                            sv_f: '-'
                        ],
                        file('${projectDir}/subworkflows/local/filter_lowconf/tests/data/family2.vcf.gz', checkIfExists: true),
                        file('${projectDir}/subworkflows/local/filter_lowconf/tests/data/family2.vcf.gz.tbi', checkIfExists: true)
                    ]
                )
                input[1] = true
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().size() > 0 },
                { assert workflow.out.vcf.size() == 2 },
                { assert snapshot(
                    workflow.out.vcf.collect { meta, vcf, tbi -> 
                        [
                            meta: [
                                id: meta.id,
                                sv_p: meta.sv_p,
                                sv_m: meta.sv_m,
                                sv_f: meta.sv_f
                            ],
                            vcf_name: file(vcf).name,
                            tbi_name: file(tbi).name
                        ]
                    }.sort { it.meta.id },
                    workflow.out.versions
                ).match() }
            )
        }
    }

    test("single sample - without intersection - stub") {
        
        options "-stub"

        when {
            workflow {
                """
                input[0] = Channel.of([
                    [
                        id: 'family1',
                        sv_p: '-',
                        sv_m: '-',
                        sv_f: '-'
                    ],
                    file('${projectDir}/subworkflows/local/filter_lowconf/tests/data/family1.vcf.gz', checkIfExists: true),
                    file('${projectDir}/subworkflows/local/filter_lowconf/tests/data/family1.vcf.gz.tbi', checkIfExists: true)
                ])
                input[1] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }
    }

    test("single sample - with intersection - stub") {
        
        options "-stub"

        when {
            workflow {
                """
                input[0] = Channel.of([
                    [
                        id: 'family2',
                        sv_p: '-',
                        sv_m: '-',
                        sv_f: '-'
                    ],
                    file('${projectDir}/subworkflows/local/filter_lowconf/tests/data/family2.vcf.gz', checkIfExists: true),
                    file('${projectDir}/subworkflows/local/filter_lowconf/tests/data/family2.vcf.gz.tbi', checkIfExists: true)
                ])
                input[1] = true
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }
    }

    test("multiple samples - mixed intersection modes - stub") {
        
        options "-stub"

        when {
            workflow {
                """
                input[0] = Channel.of(
                    [
                        [
                            id: 'family1',
                            sv_p: '-',
                            sv_m: '-',
                            sv_f: '-'
                        ],
                        file('${projectDir}/subworkflows/local/filter_lowconf/tests/data/family1.vcf.gz', checkIfExists: true),
                        file('${projectDir}/subworkflows/local/filter_lowconf/tests/data/family1.vcf.gz.tbi', checkIfExists: true)
                    ],
                    [
                        [
                            id: 'family2',
                            sv_p: '-',
                            sv_m: '-',
                            sv_f: '-'
                        ],
                        file('${projectDir}/subworkflows/local/filter_lowconf/tests/data/family2.vcf.gz', checkIfExists: true),
                        file('${projectDir}/subworkflows/local/filter_lowconf/tests/data/family2.vcf.gz.tbi', checkIfExists: true)
                    ]
                )
                input[1] = true
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }
    }

}