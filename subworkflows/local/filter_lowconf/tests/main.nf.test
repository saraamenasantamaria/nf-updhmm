nextflow_workflow {

    name "Test Subworkflow FILTER_LOWCONF"
    script "../main.nf"
    workflow "FILTER_LOWCONF"
    
    tag "subworkflows"
    tag "subworkflows_local"
    tag "filter_lowconf"
    tag "bcftools"
    tag "bcftools/view"
    tag "bcftools/setgt"
    tag "bcftools/setgt_vaf"

    test("trio vcf without intersection and vaf correction") {
        
        config "./nextflow.config"
        
        when {
            workflow {
                """
                input[0] = Channel.of([
                    [
                        id: 'trio_test',
                        sv_p: '-',
                        sv_m: '-', 
                        sv_f: '-'
                    ],
                    file('${projectDir}/subworkflows/local/filter_lowconf/tests/data/trio_test.vcf.gz', checkIfExists: true),
                    file('${projectDir}/subworkflows/local/filter_lowconf/tests/data/trio_test.vcf.gz.tbi', checkIfExists: true)
                ])
                input[1] = false
                input[2] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().size() > 0 },
                { assert workflow.out.vcf.size() == 1 },
                { assert snapshot(
                    workflow.out.vcf.collect { meta, vcf, tbi -> 
                        [
                            meta: [
                                id: meta.id,
                                sv_p: meta.sv_p,
                                sv_m: meta.sv_m,
                                sv_f: meta.sv_f
                            ],
                            vcf_name: file(vcf).name,
                            tbi_name: file(tbi).name
                        ]
                    },
                    workflow.out.versions
                ).match() }
            )
        }
    }

    test("trio vcf with intersection and without vaf correction") {

        config "./nextflow.config"
        
        when {
            workflow {
                """
                input[0] = Channel.of([
